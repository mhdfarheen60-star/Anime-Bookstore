# Backend environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control – it is gitignored.

PORT=5000
# Use NODE_ENV=development locally and NODE_ENV=production in production.
# In production the server refuses to start with a missing/weak JWT_SECRET or without CORS origins.
NODE_ENV=development

MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_long_random_secret_min_32_characters

# Comma-separated list of allowed frontend origins for CORS (credentials enabled).
# Include your deployed frontend URL in production.
CLIENT_URL=http://localhost:5173
# Public URL of the frontend, used to build Stripe Checkout redirect URLs.
FRONTEND_URL=http://localhost:5173

# Cookie behaviour for the auth token (cookie + CSRF double-submit).
#   lax  (default) works for same-site deployments (e.g. localhost or app.example.com + api.example.com)
#   none requires HTTPS and is needed only for cross-site frontend/backend deployments (e.g. Render frontend + Render backend)
# COOKIE_SAMESITE=lax

# Google sign-in: OAuth 2.0 Web client ID from Google Cloud Console (must match VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Optional: Google Books API key for admin cover search (Open Library works without one)
GOOGLE_BOOKS_API_KEY=

# Razorpay (test mode). Key secret stays backend-only; never commit real values.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_CHECKOUT_CONFIG_ID=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (test mode). Secret key stays backend-only; webhook secret is verified server-side.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
